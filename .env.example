# ──────────────────────────────────────────────
# RAASOA Configuration
# ──────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://raasoa:raasoa_dev@localhost:5433/raasoa

# ──────────────────────────────────────────────
# Embedding Provider: ollama | openai | cohere
# ──────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama

# Embedding vector dimensions (must match model output)
EMBEDDING_DIMENSIONS=768

# ── Ollama (Local, Default) ──────────────────
# Data stays local. No API keys needed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── OpenAI ───────────────────────────────────
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ── Azure OpenAI ─────────────────────────────
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=your-azure-api-key
# OPENAI_BASE_URL=https://your-resource.openai.azure.com
# OPENAI_API_VERSION=2024-02-01
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ── OpenAI-Compatible (vLLM, LiteLLM, etc.) ─
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=dummy
# OPENAI_BASE_URL=http://localhost:8080/v1
# OPENAI_EMBEDDING_MODEL=your-model-name
# EMBEDDING_DIMENSIONS=768

# ── Cohere ───────────────────────────────────
# EMBEDDING_PROVIDER=cohere
# COHERE_API_KEY=xxx
# COHERE_BASE_URL=https://api.cohere.com
# COHERE_EMBEDDING_MODEL=embed-v4.0
# EMBEDDING_DIMENSIONS=1024

# ──────────────────────────────────────────────
# Chunking
# ──────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# Upload limits
MAX_FILE_SIZE_MB=100

# ──────────────────────────────────────────────
# Quality & Governance
# ──────────────────────────────────────────────
QUALITY_GATE_ENABLED=true
QUALITY_PUBLISH_THRESHOLD=0.8

CONFLICT_DETECTION_ENABLED=true
CONFLICT_SEMANTIC_THRESHOLD=0.15

# Claim Extraction (LLM-based, uses Ollama)
CLAIM_EXTRACTION_ENABLED=true
OLLAMA_CHAT_MODEL=qwen3:8b

# LLM Judge: ask the LLM to recommend which of two conflicting claims is
# correct. judge_conflict() (get a recommendation) and manual
# /v1/conflicts/{id}/resolve always work; LLM_JUDGE_ENABLED only controls
# whether the judge additionally auto-resolves conflicts above
# LLM_JUDGE_AUTO_RESOLVE_THRESHOLD unattended during ingestion (a claim
# below the threshold is always left for human review regardless). On by
# default per product decision — permanent claim supersession with no
# human in the loop is a real-stakes action even scoped to a single
# claim, so lower LLM_JUDGE_AUTO_RESOLVE_THRESHOLD or set
# LLM_JUDGE_ENABLED=false if that risk isn't acceptable for your data.
LLM_JUDGE_ENABLED=true
LLM_JUDGE_AUTO_RESOLVE_THRESHOLD=0.85

# Reranking: passthrough | ollama | cohere. "ollama" runs a full LLM
# relevance judgment per candidate chunk on every query -- real
# latency/cost, but raw embedding confidence alone can't reliably tell
# "nothing matches" apart from "something matches moderately" (see
# AUDIT_AND_FIX_PLAN.md #8). Requires ollama_chat_model to be pulled;
# docker-compose.yml's ollama-pull service already does this by default.
RERANKER=ollama

# ──────────────────────────────────────────────
# Authentication
#
# SECURITY: the defaults below are for local/self-hosted use on a
# trusted network (matches the README quickstart — the dashboard's Load
# Demo Data button works immediately, no login step). Before exposing
# RAASOA on the public internet, set:
#   AUTH_ENABLED=true
#   DASHBOARD_PASSWORD=<a strong password>
#   CORS_ORIGINS=https://your-frontend.example.com
#   SIGNUP_ENABLED=false
# ──────────────────────────────────────────────
AUTH_ENABLED=false

# API Keys: comma-separated "key:tenant_id" pairs
# API_KEYS=sk-dev-key:00000000-0000-0000-0000-000000000001

# Webhook shared secret
# WEBHOOK_SECRET=whsec-your-secret-here

# Dashboard password (empty = open access)
# DASHBOARD_PASSWORD=your-password

# Encrypts connector credentials (Notion token, SharePoint client_secret,
# Jira api_token) at rest in sources.connection_config. Empty = stored in
# plaintext (logs a warning). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CONNECTOR_ENCRYPTION_KEY=

# Public signup (disable for controlled enterprise deployments)
SIGNUP_ENABLED=true

# Comma-separated browser origins. Empty = allow all for local/dev.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ──────────────────────────────────────────────
# Rate Limiting (requests per minute per tenant)
# ──────────────────────────────────────────────
INGEST_RATE_LIMIT_PER_MINUTE=30
RETRIEVE_RATE_LIMIT_PER_MINUTE=120

# ──────────────────────────────────────────────
# Dashboard
# ──────────────────────────────────────────────
DASHBOARD_ENABLED=true

# ──────────────────────────────────────────────
# MCP Policy-Gate
# ──────────────────────────────────────────────
# Server-side default clearance for MCP tool calls. Documents with a
# higher classification (frontmatter `classification:`) are filtered
# out of every result and the denial is audit-logged.
# Levels: public < internal < restricted < confidential < secret
RAASOA_MCP_DEFAULT_CLEARANCE=public

# Remote MCP over HTTP (Streamable HTTP at POST /mcp) — lets cloud clients
# (Claude.ai, LangDock, Copilot Studio) connect. See INTEGRATIONS.md.
MCP_HTTP_ENABLED=true
# URL the in-process MCP transport calls back into (the REST API itself).
MCP_INTERNAL_URL=http://localhost:8000

# ──────────────────────────────────────────────
# Worker / Scheduler (containerised: see docker-compose.yml)
# ──────────────────────────────────────────────
# Source-sync poll interval, seconds. Per-source intervals are still respected.
SCHEDULER_SYNC_INTERVAL=60
# Job queue drain interval, seconds.
SCHEDULER_QUEUE_INTERVAL=30
# Retention/GDPR purge interval, seconds. 21600 = 6h.
SCHEDULER_RETENTION_INTERVAL=21600

# ──────────────────────────────────────────────
# Logging / Process
# ──────────────────────────────────────────────
LOG_LEVEL=info
UVICORN_WORKERS=2

# ──────────────────────────────────────────────
# Observability (only used by docker-compose.monitoring.yml)
# ──────────────────────────────────────────────
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=changeme
